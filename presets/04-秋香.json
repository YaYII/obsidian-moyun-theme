    "moyun@@my-tone@@dark": "my-tone-qiuxiang",
    "moyun@@my-indent-on@@dark": false,
    "moyun@@my-justify@@dark": false,
    "moyun@@my-ui-compact@@dark": true,
    "moyun@@my-immersive-by-default@@dark": true,
