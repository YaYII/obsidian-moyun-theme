    "moyun@@my-font-size-base@@light": 17,
    "moyun@@my-line-height-relaxed@@light": 1.95,
    "moyun@@my-content-width@@light": "42rem",
    "moyun@@my-heading-underline@@light": false,
    "moyun@@my-tone@@dark": "my-tone-zhuqing",
    "moyun@@my-indent-on@@dark": true,
    "moyun@@my-justify@@dark": true,
    "moyun@@my-heading-serif-toggle@@dark": true,
    "moyun@@my-font-size-base@@dark": 17,
    "moyun@@my-line-height-relaxed@@dark": 1.95,
    "moyun@@my-content-width@@dark": "42rem",
    "moyun@@my-heading-underline@@dark": false
  }
